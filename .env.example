# Watermark Remover — Environment Configuration
# =================================================
# Copy this file to .env and adjust values.
# Each setting can also be overridden via an environment variable
# prefixed with WATERMARKS_ (see configuration.py for the full mapping).

# ─── Asset Limits ───────────────────────────────────────────────
# Maximum input file size in bytes (default: 100 MB)
# WATERMARKS_MAX_FILE_SIZE=104857600

# Maximum pixel count for image operations (default: 40 000 000)
# Covers 8K UHD; set lower for constrained environments.
# WATERMARKS_MAX_IMAGE_PIXELS=40000000

# ─── Batch Processing ──────────────────────────────────────────
# Concurrent batch file processing limit (default: 4)
# WATERMARKS_MAX_CONCURRENCY=4

# ─── Logging ────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# WATERMARKS_LOG_LEVEL=INFO

# ─── Rewrite Engine (Layer B) ──────────────────────────────────
# Backend: print-prompt | ollama | openai-compatible (default: print-prompt)
# WATERMARKS_REWRITE_BACKEND=print-prompt

# Base URL for the LLM backend (default: http://127.0.0.1:11434)
# Set to your Ollama or OpenAI-compatible endpoint.
# WATERMARKS_REWRITE_BASE_URL=http://127.0.0.1:11434

# Model name for the backend
# Required for ollama and openai-compatible backends.
# WATERMARKS_REWRITE_MODEL=qwen3:latest

# API key for authenticated backends (optional)
# WATERMARKS_REWRITE_API_KEY=

# Disable thinking mode on reasoning-capable models (default: false)
# Set to "true" for direct answers from Qwen/Transformers-compatible servers.
# WATERMARKS_REWRITE_DISABLE_THINKING=false

# Timeout in seconds for rewrite operations (default: 120)
# WATERMARKS_REWRITE_TIMEOUT=120

# ─── TSAPA Evolutionary Rewrite ────────────────────────────────
# Default maximum generations (default: 5)
# WATERMARKS_MAX_REWRITE_GENERATIONS=5

# Default maximum population per chunk (default: 12)
# WATERMARKS_MAX_REWRITE_POPULATION=12

# Model name for pseudo-log-likelihood scoring (inherits from REWRITE_MODEL if not set)
# WATERMARKS_PLL_MODEL=qwen3:latest

# Model name for embedding scoring (inherits from REWRITE_MODEL if not set)
# WATERMARKS_EMBED_MODEL=qwen3:latest

# ─── Input Limits ────────────────────────────────────────────────
# Max input bytes (default: 256 MiB). WATERMARKS_MAX_FILE_SIZE above is a
# deprecated alias of this key; the canonical key wins when both are set.
# WATERMARKS_MAX_INPUT_BYTES=268435456
# Watermarks_MAX_STDIN_BYTES=67108864

# ─── Core HTTP service (wm-serve) ───────────────────────────────
# Optional bearer token for the HTTP API. When set, every request must send
# Authorization: Bearer <key>.
WATERMARKS_SERVER_API_KEY=
# WATERMARKS_SERVER_HOST=127.0.0.1
# WATERMARKS_SERVER_PORT=8765
# WATERMARKS_SERVER_VERSION=

# ─── Vendor text-watermark detection ────────────────────────────
# Optional Google Gemini API key. When set, the service can run Google's
# official SynthID-text watermark detector via POST /detect and the
# detect_before / detect_after clean options. Env only — never on argv.
# Privacy: text is sent to Google only when this key is configured.
# WATERMARKS_GEMINI_API_KEY=
# WATERMARKS_GEMINI_MODEL=gemini-2.5-flash
# WATERMARKS_GEMINI_TIMEOUT=30
# WATERMARKS_GEMINI_MAX_CHARS=1000000

# Optional MarkLLM research harness (host checkouts only; not in the core
# image). Same-config-only detection — not a vendor oracle.
# MARKLLM_DIR=~/MarkLLM                    # bare upstream-pointer convention
# WATERMARKS_MARKLLM_SCHEME=kgw           # kgw | synthid

# ─── Harness / heavy backends ───────────────────────────────────
# Optional Hugging Face token for gated models (CtrlRegen, MarkLLM,
# MarkDiffusion score models). Env only — never on argv.
HF_TOKEN=

# SynthID image scoring over HTTP (heavy profile): point wr-core at the
# wr-synthid-score sidecar and share the same bearer key on both sides.
# WATERMARKS_SYNTHID_SCORER_URL=http://wr-synthid-score:8766
# WATERMARKS_SYNTHID_SCORER_API_KEY=
# WATERMARKS_SYNTHID_SCORER_TIMEOUT=60

# ─── Client-side (used by the skill or curl, NOT by compose) ────
# Where to reach the service. Defaults to http://127.0.0.1:8765.
# WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# ─── Layer B rewrite extras ─────────────────────────────────────
# WATERMARKS_REWRITE_ALLOW_REMOTE=1        # only for non-loopback endpoints
# WATERMARKS_REWRITE_REASONING_EFFORT=none # none/low/medium/high, or off to omit

# ─── Child-process resource limits ──────────────────────────────
# WATERMARKS_CHILD_RLIMIT_AS=4294967296
# WATERMARKS_CHILD_RLIMIT_FSIZE=2147483648
