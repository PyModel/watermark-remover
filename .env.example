# Watermark Remover — Environment Configuration
# =================================================
# Copy this file to .env and adjust values.
# Each setting can also be overridden via an environment variable
# prefixed with WATERMARKS_ (see configuration.py for the full mapping).

# ─── Asset Limits ───────────────────────────────────────────────
# Maximum input file size in bytes (default: 100 MB)
# WATERMARKS_MAX_FILE_SIZE=104857600

# Maximum pixel count for image operations (default: 40 000 000)
# Covers 8K UHD; set lower for constrained environments.
# WATERMARKS_MAX_IMAGE_PIXELS=40000000

# ─── Batch Processing ──────────────────────────────────────────
# Concurrent batch file processing limit (default: 4)
# WATERMARKS_MAX_CONCURRENCY=4

# ─── Logging ────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# WATERMARKS_LOG_LEVEL=INFO

# ─── Rewrite Engine (Layer B) ──────────────────────────────────
# Backend: print-prompt | ollama | openai-compatible (default: print-prompt)
# WATERMARKS_REWRITE_BACKEND=print-prompt

# Base URL for the LLM backend (default: http://127.0.0.1:11434)
# Set to your Ollama or OpenAI-compatible endpoint.
# WATERMARKS_REWRITE_BASE_URL=http://127.0.0.1:11434

# Model name for the backend
# Required for ollama and openai-compatible backends.
# WATERMARKS_REWRITE_MODEL=qwen3:latest

# API key for authenticated backends (optional)
# WATERMARKS_REWRITE_API_KEY=

# Disable thinking mode on reasoning-capable models (default: false)
# Set to "true" for direct answers from Qwen/Transformers-compatible servers.
# WATERMARKS_REWRITE_DISABLE_THINKING=false

# Timeout in seconds for rewrite operations (default: 120)
# WATERMARKS_REWRITE_TIMEOUT=120

# ─── TSAPA Evolutionary Rewrite ────────────────────────────────
# Default maximum generations (default: 5)
# WATERMARKS_MAX_REWRITE_GENERATIONS=5

# Default maximum population per chunk (default: 12)
# WATERMARKS_MAX_REWRITE_POPULATION=12

# Model name for pseudo-log-likelihood scoring (inherits from REWRITE_MODEL if not set)
# WATERMARKS_PLL_MODEL=qwen3:latest

# Model name for embedding scoring (inherits from REWRITE_MODEL if not set)
# WATERMARKS_EMBED_MODEL=qwen3:latest
