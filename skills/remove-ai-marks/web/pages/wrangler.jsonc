// The static site plus the free hosted model for Rewrite. Static assets serve every path
// (dist-pages/_headers sets the CSP and caching); only /api/* runs worker.ts, which calls
// Workers AI under a daily budget kept in the Budget Durable Object. Deploy: make pages-deploy
{
  "name": "watermark-remover",
  "account_id": "1020f6f28ab73dc9dedb54c461ff1aa0",
  "compatibility_date": "2026-10-06",
  "main": "worker.ts",
  "assets": { "directory": "../dist-pages", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "Budget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  "routes": [{ "pattern": "watermark.pymodel.com", "custom_domain": true }]
}
